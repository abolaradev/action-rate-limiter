{
    "name": "abolaradev/action-rate-limiter",
    "description": "A lightweight Laravel rate limiter package built on top of Laravel's native Rate Limiter, providing an extended and more convenient API for defining, managing, and controlling rate limits across your application.",
    "keywords": [
        "abolaradev",
        "laravel",
        "livewire-rate-limiter"
    ],
    "homepage": "https://github.com/abolaradev/action-rate-limiter",
    "license": "MIT",
    "authors": [
        {
            "name": "abolaradev",
            "email": "abolfazlebrahimi923395@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Abolaradev\\ActionRateLimiter\\": "src/",
            "Abolaradev\\ActionRateLimiter\\Database\\Factories\\": "database/factories/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Abolaradev\\ActionRateLimiter\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@composer run prepare"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abolaradev\\ActionRateLimiter\\ActionRateLimiterServiceProvider"
            ],
            "aliases": {
                "ActionRateLimiter": "Abolaradev\\ActionRateLimiter\\Facades\\ActionRateLimiter"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}